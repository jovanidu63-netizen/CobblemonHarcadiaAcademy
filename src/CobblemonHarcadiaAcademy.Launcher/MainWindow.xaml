<Window x:Class="HarcadiaLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cobblemon Harcadia Academy" Height="720" Width="1040" MinHeight="650" MinWidth="900" WindowStartupLocation="CenterScreen" Foreground="{StaticResource Ink}">
 <Window.Background><ImageBrush ImageSource="Assets/harcadia-background.png" Stretch="UniformToFill"/></Window.Background>
 <Grid>
  <Rectangle Fill="#3507182E"/>
  <Border Width="260" Height="42" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,20,0" CornerRadius="21" Background="#DE12243A" BorderBrush="#C8EBC577" BorderThickness="1"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><Ellipse Width="10" Height="10" Fill="#FFC553" Margin="0,0,9,0"/><TextBlock x:Name="VersionText" Text="MINECRAFT 1.21.1 · FABRIC" FontSize="11" FontWeight="Bold" Foreground="#FFF3D0" VerticalAlignment="Center"/></StackPanel></Border>
  <Border VerticalAlignment="Bottom" Margin="18,0,18,16" Padding="16,11,16,10" CornerRadius="20" Background="#EA0B1930" BorderBrush="#EAC485" BorderThickness="1">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="3,0,3,9"><TextBlock x:Name="TitleText" Text="Harcadia Academy" FontSize="14" FontWeight="Bold" Foreground="#FFF2D0"/><TextBlock x:Name="ServerText" Text="game06.helloserv.fr:25512" DockPanel.Dock="Right" FontSize="11" Foreground="#DDE9F1" VerticalAlignment="Center"/></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
     <Button x:Name="PlayButton" Grid.Column="0" Content="INSTALLER ET JOUER" Height="44" Margin="2,0,10,0" FontSize="13" FontWeight="Bold" Background="#F2B843" Foreground="#1B2B41" BorderBrush="#FFE6A1" BorderThickness="1" Click="Play_Click" IsEnabled="False"/>
     <StackPanel Grid.Column="1" Margin="2,0,10,0"><Button x:Name="LoginButton" Content="CONNEXION MICROSOFT" Height="27" FontSize="10" FontWeight="Bold" Click="Login_Click" Background="#2F6798" Foreground="White" BorderThickness="0"/><TextBox x:Name="UsernameBox" Text="Non connecté" IsReadOnly="True" Height="22" Padding="6,2" Margin="0,3,0,0" Background="#8E12243A" Foreground="#FFF4D9" BorderBrush="#657D97" FontSize="10"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="2,0,11,0"><DockPanel><TextBlock Text="RAM" FontSize="10" FontWeight="Bold" Foreground="#E7D6AE"/><TextBlock x:Name="RamLabel" Text="6 Go" DockPanel.Dock="Right" FontSize="10" Foreground="#FFE1A0"/></DockPanel><Slider x:Name="RamSlider" Minimum="4" Maximum="16" Value="6" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RamSlider_Changed" Margin="0,0,0,0" Foreground="#F2B843"/></StackPanel>
     <DockPanel Grid.Column="3" Margin="2,0,0,0"><Button Content="Parcourir" DockPanel.Dock="Right" Padding="9,4" Margin="5,0,0,0" Click="Browse_Click" Background="#345C76" Foreground="White" BorderThickness="0" FontSize="10"/><TextBox x:Name="DirectoryBox" IsReadOnly="True" Height="32" Padding="7,7" Background="#8E12243A" Foreground="#F6F0DB" BorderBrush="#657D97" FontSize="10"/></DockPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="2,9,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Grid.Column="0" Click="Discord_Click" Height="34" Padding="12,0" Margin="0,0,8,0" Background="#3266A0" Foreground="White" BorderBrush="#9CC9EA" BorderThickness="1" ToolTip="Rejoindre le Discord"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="23" Height="20" Margin="0,0,8,0"><Canvas Width="40" Height="32"><Path Fill="White" Data="M8,5 C14,2 26,2 32,5 C36,11 38,18 37,25 C33,28 30,30 26,31 L23,27 C26,26 28,24 30,22 C24,25 16,25 10,22 C12,24 14,26 17,27 L14,31 C10,30 7,28 3,25 C2,18 4,11 8,5 Z"/><Ellipse Canvas.Left="12" Canvas.Top="14" Width="4" Height="5" Fill="#3266A0"/><Ellipse Canvas.Left="24" Canvas.Top="14" Width="4" Height="5" Fill="#3266A0"/></Canvas></Viewbox><TextBlock Text="DISCORD" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/></StackPanel></Button>
     <Button Grid.Column="1" Click="Store_Click" Height="34" Padding="12,0" Margin="0,0,11,0" Background="#287650" Foreground="White" BorderBrush="#B7D9A3" BorderThickness="1" ToolTip="Ouvrir la boutique"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="18" Height="20" Margin="0,0,8,0"><Canvas Width="24" Height="28"><Path Data="M4,9 L20,9 L22,26 L2,26 Z M8,10 C8,2 16,2 16,10" Stroke="#FFF5DB" StrokeThickness="2" Fill="Transparent"/></Canvas></Viewbox><TextBlock Text="BOUTIQUE" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/></StackPanel></Button>
     <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Connecte-toi pour continuer." TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="#FFF4D9" FontSize="10"/><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="False" Margin="0,3,0,0" Background="#162A42" Foreground="#F2B843"/></StackPanel>
     <Button Grid.Column="3" Content="CONFIGURATION" Margin="12,0,0,0" Padding="7,4" Background="Transparent" Foreground="#EFD79E" BorderThickness="0" FontSize="9" Click="OpenConfig_Click"/>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>

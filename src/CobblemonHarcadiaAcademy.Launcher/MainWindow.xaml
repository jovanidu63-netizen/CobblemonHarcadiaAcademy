<Window x:Class="HarcadiaLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CobblemonHarcadiaAcademy" Height="720" Width="1040" MinHeight="650" MinWidth="900" WindowStartupLocation="CenterScreen" Background="#0D2121" Foreground="{StaticResource Ink}">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,24"><Border Width="72" Height="72" CornerRadius="18" Background="#173633" BorderBrush="#D6C184" BorderThickness="1" DockPanel.Dock="Left"><Viewbox Margin="12"><Canvas Width="64" Height="64"><Path Data="M32,2 L58,17 L58,47 L32,62 L6,47 L6,17 Z" Fill="#70BFA5" Stroke="#E9DCAF" StrokeThickness="2"/><Ellipse Canvas.Left="22" Canvas.Top="18" Width="20" Height="20" Fill="#FFF1C2"/><Path Data="M17,46 Q32,30 47,46" Stroke="#183B38" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border><StackPanel Margin="18,7"><TextBlock x:Name="TitleText" Text="CobblemonHarcadiaAcademy" FontSize="28" FontWeight="Bold"/><TextBlock Text="UNE AVENTURE COBBLEMON · FABRIC 1.21.1" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5"/></StackPanel><TextBlock x:Name="VersionText" Text="PRÊT À CONFIGURER" DockPanel.Dock="Right" Foreground="#D6C184" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#14302D" CornerRadius="24" Padding="28"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="BIENVENUE À HARCADIA" Foreground="#D6C184" FontSize="13" FontWeight="Bold"/><TextBlock Text="Ton aventure&#10;commence ici." FontSize="43" FontWeight="Bold" Margin="0,18"/><TextBlock Text="Le launcher installe Minecraft et Fabric, puis synchronise les fichiers du modpack publié par le serveur." TextWrapping="Wrap" FontSize="16" Foreground="{StaticResource Muted}" LineHeight="25"/><TextBlock x:Name="ServerText" Text="Serveur : adresse à configurer" Margin="0,22,0,0" Foreground="#D6C184"/></StackPanel><StackPanel Grid.Row="1"><Button x:Name="PlayButton" Content="INSTALLER ET JOUER" Height="58" FontSize="17" FontWeight="Bold" Background="#D6C184" Foreground="#142A28" BorderThickness="0" Click="Play_Click" IsEnabled="False"/><TextBlock Text="Connecte-toi avec le compte Microsoft qui possède Minecraft Java. Le launcher ne demande ni ne conserve ton mot de passe." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,13,0,0" FontSize="12"/></StackPanel></Grid></Border>
   <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="24" Padding="24"><StackPanel><TextBlock Text="COMPTE ET RÉGLAGES" FontSize="19" FontWeight="Bold"/><Button x:Name="LoginButton" Content="SE CONNECTER AVEC MICROSOFT" Height="42" Margin="0,20,0,0" Click="Login_Click" Background="#254942" Foreground="{StaticResource Ink}" BorderThickness="0"/><TextBlock Text="Compte connecté" Foreground="{StaticResource Muted}" Margin="0,15,0,7"/><TextBox x:Name="UsernameBox" Text="Non connecté" IsReadOnly="True" Height="38" Padding="10,8" Background="#102927" Foreground="{StaticResource Ink}" BorderBrush="#35564E"/><TextBlock Text="Mémoire vive allouée" Foreground="{StaticResource Muted}" Margin="0,18,0,7"/><DockPanel><TextBlock x:Name="RamLabel" Text="6 Go" DockPanel.Dock="Right" Foreground="#D6C184"/><Slider x:Name="RamSlider" Minimum="4" Maximum="16" Value="6" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RamSlider_Changed"/></DockPanel><TextBlock Text="Dossier du jeu" Foreground="{StaticResource Muted}" Margin="0,18,0,7"/><DockPanel><Button Content="Parcourir…" DockPanel.Dock="Right" Padding="11,7" Click="Browse_Click" Background="#254942" Foreground="{StaticResource Ink}" BorderThickness="0"/><TextBox x:Name="DirectoryBox" IsReadOnly="True" Height="38" Padding="9,8" Background="#102927" Foreground="{StaticResource Ink}" BorderBrush="#35564E"/></DockPanel><TextBlock Text="ÉTAT" Foreground="{StaticResource Muted}" Margin="0,20,0,8"/><TextBlock x:Name="StatusText" Text="Connecte-toi pour continuer. Adresse serveur et manifeste du modpack à configurer." TextWrapping="Wrap" Foreground="{StaticResource Ink}"/><ProgressBar x:Name="Progress" Height="5" IsIndeterminate="False" Margin="0,14,0,0" Background="#102927" Foreground="#A5E6CC"/><Button Content="Ouvrir le dossier de configuration" Margin="0,18,0,0" HorizontalAlignment="Left" Padding="0" Background="Transparent" Foreground="#D6C184" BorderThickness="0" Click="OpenConfig_Click"/></StackPanel></Border>
  </Grid><TextBlock Grid.Row="2" Text="COBBLEMON HARCARDIA ACADEMY  ·  FABRIC  ·  WINDOWS" Foreground="#638077" FontSize="11" HorizontalAlignment="Center" Margin="0,20,0,0"/>
 </Grid>
</Window>
